{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.fluttersdk/ai",
    "title": "FlutterSDK Docs",
    "description": "Search Wind UI, Magic, Dusk, Telescope and Artisan documentation. Hosted, public, no auth.",
